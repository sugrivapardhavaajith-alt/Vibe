{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "chatbot",
          "format": "url",
          "env": "CHATBOT_URL"
        }
      ]
    },
    "chatbot": {
      "root": "backend/src/modules/chatbot/python",
      "framework": "fastapi"
    },
    "docs": {
      "root": "docs",
      "framework": "docusaurus-2"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
